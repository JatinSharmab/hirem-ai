APP_MODE=live
APP_ENV=development
APP_NAME=HireMe AI
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+asyncpg://hireme:hireme@localhost:5432/hireme
GEMINI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.1-flash-lite
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=768
FRONTEND_URL=http://localhost:8501
ALLOWED_ORIGINS=http://localhost:8501
ENABLE_LIVE_JOB_DISCOVERY=true
ENABLE_DEVELOPER_MODE=true
ENABLE_LANGSMITH=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=hireme-ai
MAX_UPLOAD_MB=5
HTTP_TIMEOUT_SECONDS=15

# Public deployment only. Leave APP_ENV=development for localhost.
# Production requires a random gateway key shared ONLY between UI and API servers.
API_GATEWAY_KEY=
DATABASE_SSL=false
# Optional CA file; required with the supplied Supabase deployment recipe.
# DATABASE_SSL_CA=/etc/secrets/supabase-ca.crt
WORKSPACE_TTL_HOURS=24
AI_CALLS_PER_VISITOR=10
AI_CALLS_PER_DAY=100
