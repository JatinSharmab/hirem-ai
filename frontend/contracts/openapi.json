  "components": {
    "schemas": {
      "ApplicationRecord": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "status": {
            "$ref": "#/components/schemas/ApplicationStatus",
            "default": "DISCOVERED"
          },
          "official_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Official Url"
          },
          "notes": {
            "type": "string",
            "title": "Notes",
            "default": ""
          },
          "resume_version_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resume Version Id"
          }
        },
        "type": "object",
        "required": [
          "id",
          "job_id"
        ],
        "title": "ApplicationRecord"
      },
      "ApplicationStatus": {
        "type": "string",
        "enum": [
          "DISCOVERED",
          "SHORTLISTED",
          "RESUME_READY",
          "READY_TO_APPLY",
          "APPLIED",
          "RECRUITER_RESPONSE",
          "INTERVIEW",
          "OFFER",
          "REJECTED",
          "WITHDRAWN"
        ],
        "title": "ApplicationStatus"
      },
      "Body_parse_profile_api_v1_profile_parse_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_parse_profile_api_v1_profile_parse_post"
      },
      "CandidateFact": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "subject": {
            "type": "string",
            "title": "Subject"
          },
          "predicate": {
            "type": "string",
            "title": "Predicate"
          },
          "value": {
            "type": "string",
            "title": "Value"
          },
          "source_section": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Section"
          },
          "source_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Text"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "default": 1.0
          },
          "verified_by_user": {
            "type": "boolean",
            "title": "Verified By User",
            "default": false
          },
          "immutable": {
            "type": "boolean",
            "title": "Immutable",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "id",
          "category",
          "subject",
          "predicate",
          "value"
        ],
        "title": "CandidateFact"
      },
      "CandidateProfile": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "summary": {
            "type": "string",
            "title": "Summary",
            "default": ""
          },
          "skills": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Skills",
            "default": []
          },
          "experience_years": {
            "type": "number",
            "title": "Experience Years",
            "default": 0
          },
          "locations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Locations",
            "default": []
          },
          "facts": {
            "items": {
              "$ref": "#/components/schemas/CandidateFact"
            },
            "type": "array",
            "title": "Facts",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "CandidateProfile"
      },
      "EvidenceMatch": {
        "properties": {
          "requirement": {
            "type": "string",
            "title": "Requirement"
          },
          "candidate_fact_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Candidate Fact Ids",
            "default": []
          },
          "evidence": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Evidence",
            "default": []
          },
          "alignment": {
            "type": "string",
            "title": "Alignment"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence"
          }
        },
        "type": "object",
        "required": [
          "requirement",
          "alignment",
          "confidence"
        ],
        "title": "EvidenceMatch"
      },
      "ExportRequest": {
        "properties": {
          "candidate": {
            "$ref": "#/components/schemas/CandidateProfile"
          },
          "version": {
            "$ref": "#/components/schemas/ResumeVersion"
          }
        },
        "type": "object",
        "required": [
