          "version"
        ],
        "title": "ExportRequest"
      },
      "GeneratedResumeBullet": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "source_fact_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Source Fact Ids"
          },
