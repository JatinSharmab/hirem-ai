# Server-only. Never prefix these with NEXT_PUBLIC_.
SERVER_ONLY_BACKEND_URL=http://127.0.0.1:8000
SERVER_ONLY_BACKEND_GATEWAY_SECRET=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SERVER_ONLY_WORKSPACE_SECRET=
# Exact local or deployed origin. Preview deployments also use VERCEL_URL automatically.
SERVER_ONLY_SITE_ORIGIN=http://127.0.0.1:3000
# Optional public canonical URL (no credentials).
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
